; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Age of Empires IV"
#define MyAppVersion "1.0"
#define MyAppPublisher "Xbox Game Studios"
#define MyAppURL "https://www.ageofempires.com/games/age-of-empires-iv/"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{CD8B1317-6CA3-4B5F-BACC-3185B669F006}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
PrivilegesRequired=admin
OutputBaseFilename={#MyAppName}
Compression=none
SolidCompression=no
WizardStyle=modern dynamic
DiskSpanning=yes
DiskSliceSize=2000000000

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Icons]
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\RelicCardinal.exe"; WorkingDir: "{app}"
Name: "{commondesktop}\Age of Empires IV LAN Server"; Filename: "{app}\aoe4lan\aoe4lan_server.exe"; WorkingDir: "{app}\aoe4lan"; IconFilename: "{app}\RelicCardinal.exe"

[Files]
Source: "D:\Inno Setup Disk\projects\source\Age of Empires IV\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[INI]
; Write the player name into steam_emu.ini
Filename: "{app}\steam_emu.ini"; Section: "Settings"; Key: "UserName"; String: "{code:GetPlayerName}"

[Code]
var
	PlayerName: String;
	PlayerNamePage: TInputQueryWizardPage;

function GetPlayerName(Param: String): String;
begin
	Result := PlayerName;
end;

procedure InitializeWizard();
begin
	// Read command-line parameter first
	PlayerName := ExpandConstant('{param:PLAYERNAME|}');

	// If not silent and no param, create an inline input page
  if (Trim(PlayerName) = '') and (not WizardSilent) then
  begin
    PlayerNamePage := CreateInputQueryPage(wpSelectDir,
    'Player name',
    'Enter the player name',
    'This name will be written into steam_emu.ini.');
    PlayerNamePage.Add('Player name:', False);
    PlayerNamePage.Values[0] := PlayerName;
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
	Result := True;
	if Assigned(PlayerNamePage) and (CurPageID = PlayerNamePage.ID) then
	begin
		PlayerName := Trim(PlayerNamePage.Values[0]);
		if PlayerName = '' then
		begin
			MsgBox('Please enter a player name to continue.', mbError, MB_OK);
			Result := False; // prevent moving forward
		end;
	end;
end;
