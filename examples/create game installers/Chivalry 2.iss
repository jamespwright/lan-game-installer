; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Chivalry 2"
#define MyAppVersion "1.0"
#define MyAppPublisher "Torn Banner Studios"
#define MyAppURL "https://www.chivalry2.com/"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{6B1D5E42-8F3A-4C97-B2E0-5A7D93C1F4E8}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
PrivilegesRequired=admin
OutputBaseFilename={#MyAppName}
Compression=none
SolidCompression=no
WizardStyle=modern dynamic
DiskSpanning=yes
DiskSliceSize=2000000000

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Icons]
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\TBL\Binaries\Win64\Chivalry2-Win64-Shipping.exe"; WorkingDir: "{app}\TBL\Binaries\Win64"
Name: "{commondesktop}\Chivalry 2 Launcher"; Filename: "{app}\Chivalry 2 LAN.exe"; WorkingDir: "{app}"; IconFilename: "{app}\TBL\Binaries\Win64\Chivalry2-Win64-Shipping.exe"

[Files]
Source: "D:\Inno Setup Disk\projects\source\Chivalry 2\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[INI]
; Write the player name into c2lan.ini
Filename: "{app}\TBL\Binaries\Win64\c2lan.ini"; Section: "Player"; Key: "Name"; String: "{code:GetPlayerName}"

[Code]
var
	PlayerName: String;
	PlayerNamePage: TInputQueryWizardPage;

function GetPlayerName(Param: String): String;
begin
	Result := PlayerName;
end;

procedure InitializeWizard();
begin
	// Read command-line parameter first
	PlayerName := ExpandConstant('{param:PLAYERNAME|}');

	// If not silent and no param, create an inline input page
  if (Trim(PlayerName) = '') and (not WizardSilent) then
  begin
    PlayerNamePage := CreateInputQueryPage(wpSelectDir,
    'Player name', 
    'Enter the player name', 
    'This name will be written into c2lan.ini.');
    PlayerNamePage.Add('Player name:', False);
    PlayerNamePage.Values[0] := PlayerName;
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
	Result := True;
	if Assigned(PlayerNamePage) and (CurPageID = PlayerNamePage.ID) then
	begin
		PlayerName := Trim(PlayerNamePage.Values[0]);
		if PlayerName = '' then
		begin
			MsgBox('Please enter a player name to continue.', mbError, MB_OK);
			Result := False; // prevent moving forward
		end;
	end;
end;